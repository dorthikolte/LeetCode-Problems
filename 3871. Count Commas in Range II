class Solution {
    public long countCommas(long n) {
        long total = 0;

        long start = 1000;
        long commas = 1;

        while (start <= n) {
            // End of the current range
            long end = start * 1000 - 1;

            long last = Math.min(n, end);

            // Count numbers in this range × commas per number
            total += (last - start + 1) * commas;

            start *= 1000;
            commas++;
        }

        return total;
    }
}
