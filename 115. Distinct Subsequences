class Solution {
    public int numDistinct(String s, String t) {
        int n = s.length();
        int m = t.length();

        // If t is longer, it can't be a subsequence of s
        if (m > n) return 0;

        // dp[j] = number of ways to form t[0...j-1]
        long[] dp = new long[m + 1];

        // Empty string can always be formed in 1 way
        dp[0] = 1;

        for (int i = 0; i < n; i++) {
            // Traverse backwards to avoid overwriting values
            for (int j = m - 1; j >= 0; j--) {
                if (s.charAt(i) == t.charAt(j)) {
                    dp[j + 1] += dp[j];
                }
            }
        }

        return (int) dp[m];
    }
}
