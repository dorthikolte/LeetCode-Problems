class Solution {
    public int maxNumberOfFamilies(int n, int[][] reservedSeats) {
        
        // Store reserved seats for only the affected rows
        HashMap<Integer, Integer> map = new HashMap<>();

        for (int[] seat : reservedSeats) {
            int row = seat[0];
            int col = seat[1];

            // Use bit (col - 1) for seat col
            map.put(row, map.getOrDefault(row, 0) | (1 << (col - 1)));
        }

        // Rows without any reservation can always fit 2 groups
        int ans = (n - map.size()) * 2;

        for (int mask : map.values()) {

            // Seats 2,3,4,5
            boolean left = (mask & (1 << 1 | 1 << 2 | 1 << 3 | 1 << 4)) == 0;

            // Seats 4,5,6,7
            boolean middle = (mask & (1 << 3 | 1 << 4 | 1 << 5 | 1 << 6)) == 0;

            // Seats 6,7,8,9
            boolean right = (mask & (1 << 5 | 1 << 6 | 1 << 7 | 1 << 8)) == 0;

            if (left && right) {
                // Both groups can sit independently
                ans += 2;
            } else if (left || middle || right) {
                // At least one group can sit
                ans += 1;
            }
        }

        return ans;
    }
}
