class Solution {
    public int minSumOfLengths(int[] arr, int target) {
        int n = arr.length;
        int INF = n + 1;

        // best[i] = minimum length of a valid subarray
        // completely inside indices [0, i - 1]
        int[] best = new int[n + 1];

        for (int i = 0; i <= n; i++) {
            best[i] = INF;
        }

        int ans = INF;
        int left = 0;
        int sum = 0;

        for (int right = 0; right < n; right++) {
            sum += arr[right];

            // Shrink window until sum <= target
            while (sum > target && left <= right) {
                sum -= arr[left++];
            }

            if (sum == target) {
                int len = right - left + 1;

                // Combine current subarray with the best
                // non-overlapping subarray before 'left'
                if (best[left] != INF) {
                    ans = Math.min(ans, len + best[left]);
                }

                // Update best for prefix ending at right
                best[right + 1] = Math.min(best[right], len);
            } else {
                // No valid subarray ending at right
                best[right + 1] = best[right];
            }
        }

        return ans == INF ? -1 : ans;
    }
}
