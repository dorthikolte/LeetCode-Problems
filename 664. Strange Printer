class Solution {
    public int strangePrinter(String s) {
        int n = s.length();
        char[] c = s.toCharArray();
        int[][] dp = new int[n + 1][n + 1];

        for (int i = n - 1; i >= 0; i--) {
            for (int j = i; j < n; j++) {
                dp[i][j] = dp[i + 1][j] + 1; // print s[i] alone
                for (int k = i + 1; k <= j; k++) {
                    if (c[k] == c[i]) {
                        int middle = (k == i + 1) ? 0 : dp[i + 1][k - 1];
                        dp[i][j] = Math.min(dp[i][j], middle + dp[k][j]);
                    }
                }
            }
        }
        return dp[0][n - 1];
    }
}
