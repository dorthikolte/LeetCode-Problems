class Solution {
    public int maxProduct(int n) {
        int[] freq = new int[10];

        while (n > 0) {
            freq[n % 10]++;
            n /= 10;
        }

        int first = -1, second = -1;

        for (int d = 9; d >= 0; d--) {
            while (freq[d] > 0) {
                if (first == -1) {
                    first = d;
                } else {
                    second = d;
                    return first * second;
                }
                freq[d]--;
            }
        }

        return 0;
    }
}
