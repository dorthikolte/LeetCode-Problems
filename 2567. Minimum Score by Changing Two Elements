import java.util.Arrays;

class Solution {
    public int minimizeSum(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;
        int a = nums[n - 1] - nums[2];     // change two smallest
        int b = nums[n - 3] - nums[0];     // change two largest
        int c = nums[n - 2] - nums[1];     // change smallest and largest
        return Math.min(a, Math.min(b, c));
    }
}
