awk '
{
    for (i = 1; i <= NF; i++) {
        if (NR == 1) {
            max = NF
        }
        a[i, NR] = $i
    }
    rows = NR
}
END {
    for (i = 1; i <= max; i++) {
        for (j = 1; j <= rows; j++) {
            if (j > 1) printf " "
            printf "%s", a[i, j]
        }
        printf "\n"
    }
}
' file.txt
