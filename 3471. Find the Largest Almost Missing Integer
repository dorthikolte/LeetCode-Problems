class Solution {
    public int largestInteger(int[] nums, int k) {
        int[] count = new int[51];

        int n = nums.length;

        // Check every subarray of size k
        for (int i = 0; i <= n - k; i++) {
            boolean[] seen = new boolean[51];

            for (int j = i; j < i + k; j++) {
                if (!seen[nums[j]]) {
                    seen[nums[j]] = true;
                    count[nums[j]]++;
                }
            }
        }

        int ans = -1;

        // Find largest number appearing in exactly one subarray
        for (int x = 0; x <= 50; x++) {
            if (count[x] == 1) {
                ans = x;
            }
        }

        return ans;
    }
}
