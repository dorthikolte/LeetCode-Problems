class Solution {
    public int minimumChanges(String s, int k) {
        int n = s.length();
        final int INF = 1_000_000;
        int[][] cost = new int[n][n];
        for (int i = 0; i < n; i++) {
            for (int j = i; j < n; j++) {
                int len = j - i + 1;
                if (len == 1) {
                    cost[i][j] = INF;
                    continue;
                }
                int best = INF;
                for (int d = 1; d < len; d++) {
                    if (len % d != 0) continue;
                    int total = 0;
                    int m = len / d; // group size
                    for (int r = 0; r < d; r++) {
                        int a = 0, b = m - 1;
                        while (a < b) {
                            if (s.charAt(i + r + a * d) != s.charAt(i + r + b * d)) total++;
                            a++;
                            b--;
                        }
                    }
                    best = Math.min(best, total);
                }
                cost[i][j] = best;
            }
        }

        int[][] dp = new int[k + 1][n + 1];
        for (int[] row : dp) java.util.Arrays.fill(row, INF);
        dp[0][0] = 0;
        for (int p = 1; p <= k; p++) {
            for (int j = 2 * p; j <= n; j++) {
                for (int i = 2 * (p - 1); i <= j - 2; i++) {
                    if (dp[p - 1][i] >= INF) continue;
                    int c = cost[i][j - 1];
                    if (c >= INF) continue;
                    dp[p][j] = Math.min(dp[p][j], dp[p - 1][i] + c);
                }
            }
        }
        return dp[k][n];
    }
}
