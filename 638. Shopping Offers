class Solution {
    private Map<List<Integer>, Integer> memo = new HashMap<>();

    public int shoppingOffers(List<Integer> price,
                              List<List<Integer>> special,
                              List<Integer> needs) {

        if (memo.containsKey(needs)) {
            return memo.get(needs);
        }

        // Option 1: Buy all remaining items individually
        int minCost = 0;

        for (int i = 0; i < price.size(); i++) {
            minCost += price.get(i) * needs.get(i);
        }

        // Option 2: Apply each special offer
        for (List<Integer> offer : special) {
            List<Integer> remaining = new ArrayList<>(needs);
            boolean valid = true;

            for (int i = 0; i < price.size(); i++) {
                if (offer.get(i) > remaining.get(i)) {
                    valid = false;
                    break;
                }

                remaining.set(i, remaining.get(i) - offer.get(i));
            }

            if (valid) {
                int cost = offer.get(price.size())
                         + shoppingOffers(price, special, remaining);

                minCost = Math.min(minCost, cost);
            }
        }

        memo.put(needs, minCost);
        return minCost;
    }
}
