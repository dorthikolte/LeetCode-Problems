class Solution {
    public int minOperations(int[] nums) {
        int n = nums.length;
        int best = Integer.MAX_VALUE;

        // Case A: rotation of sorted
        int k = nums[0];
        boolean ok = true;
        for (int i = 0; i < n; i++) {
            if (nums[i] != (i + k) % n) { ok = false; break; }
        }
        if (ok) {
            int cost = (k == 0) ? 0 : Math.min(n - k, k + 2);
            best = Math.min(best, cost);
        }

        // Case B: rotation of reversed sorted
        ok = true;
        for (int i = 0; i < n; i++) {
            if (nums[i] != ((k - i) % n + n) % n) { ok = false; break; }
        }
        if (ok) {
            int kp = (k + 1) % n;
            int cost = 1 + Math.min((n - kp) % n, kp);
            best = Math.min(best, cost);
        }

        return best == Integer.MAX_VALUE ? -1 : best;
    }
}
