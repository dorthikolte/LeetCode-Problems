class Solution {
    public boolean isRectangleOverlap(int[] rec1, int[] rec2) {
        // Overlap exists only if both the x-axis and y-axis
        // projections overlap with positive length.
        return rec1[0] < rec2[2] &&  // rec1's left < rec2's right
               rec1[2] > rec2[0] &&  // rec1's right > rec2's left
               rec1[1] < rec2[3] &&  // rec1's bottom < rec2's top
               rec1[3] > rec2[1];    // rec1's top > rec2's bottom
    }
}
