class Solution {
    public String lexGreaterPermutation(String s, String target) {
        int n = s.length();

        int[] freq = new int[26];
        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }

        // We try to match target from left to right.
        // At every position, save the state before using target[i].
        int[][] states = new int[n + 1][26];
        states[0] = freq.clone();

        for (int i = 0; i < n; i++) {
            int c = target.charAt(i) - 'a';

            if (states[i][c] == 0) {
                break;
            }

            states[i + 1] = states[i].clone();
            states[i + 1][c]--;
        }

        // Find the rightmost position where we can put
        // a character greater than target[i].
        for (int i = n - 1; i >= 0; i--) {
            int[] remaining = states[i].clone();
            int current = target.charAt(i) - 'a';

            for (int c = current + 1; c < 26; c++) {
                if (remaining[c] > 0) {
                    StringBuilder ans = new StringBuilder();

                    // Same prefix as target
                    ans.append(target, 0, i);

                    // Smallest possible greater character
                    ans.append((char) ('a' + c));
                    remaining[c]--;

                    // Remaining characters in sorted order
                    for (int x = 0; x < 26; x++) {
                        while (remaining[x] > 0) {
                            ans.append((char) ('a' + x));
                            remaining[x]--;
                        }
                    }

                    return ans.toString();
                }
            }
        }

        return "";
    }
}
