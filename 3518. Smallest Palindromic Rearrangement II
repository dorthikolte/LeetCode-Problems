class Solution {
    static final int CAP = 1_000_001;

    public String smallestPalindrome(String s, int k) {
        int[] freq = new int[26];
        for (char c : s.toCharArray()) freq[c - 'a']++;

        int[] half = new int[26];
        int halfLen = 0;
        char mid = 0;
        for (int i = 0; i < 26; i++) {
            half[i] = freq[i] / 2;
            halfLen += half[i];
            if ((freq[i] & 1) == 1) mid = (char) ('a' + i);
        }

        Precomp pre = new Precomp(halfLen);

        if (countWays(half, halfLen, pre) < k) return "";

        StringBuilder left = new StringBuilder();

        for (int pos = 0; pos < halfLen; pos++) {
            for (int c = 0; c < 26; c++) {
                if (half[c] == 0) continue;

                half[c]--;
                int ways = countWays(half, halfLen - pos - 1, pre);

                if (ways >= k) {
                    left.append((char) ('a' + c));
                    break;
                } else {
                    k -= ways;
                    half[c]++;
                }
            }
        }

        StringBuilder ans = new StringBuilder();
        ans.append(left);
        if (mid != 0) ans.append(mid);
        ans.append(new StringBuilder(left).reverse());

        return ans.toString();
    }

    static class Precomp {
        int[] primes;
        int[][] factExp;
        int[] primeIndex;

        Precomp(int maxN) {
            int[] spf = new int[maxN + 1];
            for (int i = 2; i <= maxN; i++) {
                if (spf[i] == 0) {
                    for (int j = i; j <= maxN; j += i) {
                        if (spf[j] == 0) spf[j] = i;
                    }
                }
            }

            int cnt = 0;
            for (int i = 2; i <= maxN; i++)
                if (spf[i] == i) cnt++;

            primes = new int[cnt];
            primeIndex = new int[maxN + 1];

            int idx = 0;
            for (int i = 2; i <= maxN; i++) {
                if (spf[i] == i) {
                    primes[idx] = i;
                    primeIndex[i] = idx;
                    idx++;
                }
            }

            factExp = new int[maxN + 1][cnt];

            for (int n = 1; n <= maxN; n++) {
                System.arraycopy(factExp[n - 1], 0, factExp[n], 0, cnt);
                int x = n;
                while (x > 1) {
                    int p = spf[x];
                    int id = primeIndex[p];
                    while (x % p == 0) {
                        factExp[n][id]++;
                        x /= p;
                    }
                }
            }
        }
    }

    private int countWays(int[] half, int len, Precomp pre) {
        int pCnt = pre.primes.length;
        int[] exp = new int[pCnt];

        System.arraycopy(pre.factExp[len], 0, exp, 0, pCnt);

        for (int c : half) {
            if (c == 0) continue;
            int[] e = pre.factExp[c];
            for (int i = 0; i < pCnt; i++) exp[i] -= e[i];
        }

        long res = 1;
        for (int i = 0; i < pCnt; i++) {
            int p = pre.primes[i];
            int e = exp[i];
            while (e-- > 0) {
                res *= p;
                if (res >= CAP) return CAP;
            }
        }
        return (int) res;
    }
}
