class Solution {
    public boolean isPossible(int[] nums) {
        int OFFSET = 1001;
        int[] count = new int[2005];
        int[] tails = new int[2005];

        for (int n : nums) {
            count[n + OFFSET]++;
        }

        for (int n : nums) {
            int i = n + OFFSET;
            if (count[i] == 0) continue;

            if (tails[i - 1] > 0) {
                count[i]--;
                tails[i - 1]--;
                tails[i]++;
            } else if (count[i + 1] > 0 && count[i + 2] > 0) {
                count[i]--;
                count[i + 1]--;
                count[i + 2]--;
                tails[i + 2]++;
            } else {
                return false;
            }
        }
        return true;
    }
}
